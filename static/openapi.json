{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenID Federation Resolver",
    "version": "1.0.0",
    "description": "Operations and federation APIs for this resolver instance."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Operations"
    },
    {
      "name": "Federation"
    },
    {
      "name": "Cache"
    },
    {
      "name": "Trust anchors"
    },
    {
      "name": "Administration"
    }
  ],
  "components": {
    "securitySchemes": {
      "MetricsBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required for GET /metrics only when METRICS_TOKEN is set."
      },
      "OperatorBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "API_KEY or a PAT (oidf_pat_\u2026) for /admin/v1. Also accepted as X-API-Key. GET /api/v1 federation and ops routes stay public. Minting PATs requires ENV API_KEY when it is set."
      },
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "X-API-Key: API_KEY or PAT for operator routes, or TA_API_KEY for trust-anchor register/unregister."
      },
      "TABearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "TA_API_KEY for POST /register-trust-anchor and DELETE registered-trust-anchors. TA_API_TOKEN is an alias. API_KEY is not accepted."
      }
    },
    "parameters": {
      "entityId": {
        "name": "entityId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Entity identifier (URL). Gin wildcard: pass the full URL."
      },
      "trustAnchor": {
        "name": "trust_anchor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "forceRefresh": {
        "name": "force_refresh",
        "in": "query",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service health"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Prometheus metrics",
        "security": [
          {
            "MetricsBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Prometheus text exposition"
          },
          "401": {
            "description": "METRICS_TOKEN set and Authorization missing or wrong"
          }
        }
      }
    },
    "/api/v1/ops": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Operations snapshot for the console",
        "responses": {
          "200": {
            "description": "JSON metrics snapshot"
          }
        }
      }
    },
    "/api/v1/entity/{entityId}": {
      "get": {
        "tags": [
          "Federation"
        ],
        "summary": "Resolve an entity statement",
        "parameters": [
          {
            "$ref": "#/components/parameters/entityId"
          },
          {
            "$ref": "#/components/parameters/trustAnchor"
          },
          {
            "$ref": "#/components/parameters/forceRefresh"
          }
        ],
        "responses": {
          "200": {
            "description": "Resolved entity"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/v1/entity-statement/{entityId}": {
      "get": {
        "tags": [
          "Federation"
        ],
        "summary": "Resolve a raw entity statement JWT",
        "parameters": [
          {
            "$ref": "#/components/parameters/entityId"
          },
          {
            "$ref": "#/components/parameters/trustAnchor"
          },
          {
            "$ref": "#/components/parameters/forceRefresh"
          }
        ],
        "responses": {
          "200": {
            "description": "entity-statement+jwt"
          }
        }
      }
    },
    "/api/v1/trust-chain/{entityId}": {
      "get": {
        "tags": [
          "Federation"
        ],
        "summary": "Resolve a trust chain",
        "parameters": [
          {
            "$ref": "#/components/parameters/entityId"
          },
          {
            "$ref": "#/components/parameters/trustAnchor"
          },
          {
            "$ref": "#/components/parameters/forceRefresh"
          },
          {
            "name": "raw",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Return JSON instead of a signed JWT when authorized"
          }
        ],
        "responses": {
          "200": {
            "description": "Trust chain JSON or resolve-response+jwt"
          }
        }
      }
    },
    "/api/v1/resolve": {
      "get": {
        "tags": [
          "Federation"
        ],
        "summary": "Official federation resolve (OpenID Federation 1.0 \u00a78.3)",
        "parameters": [
          {
            "name": "sub",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "trust_anchor",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entity_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "resolve-response+jwt"
          }
        }
      }
    },
    "/api/v1/federation_list": {
      "get": {
        "tags": [
          "Federation"
        ],
        "summary": "Federation member list",
        "parameters": [
          {
            "name": "trust_anchor",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entity_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Member list"
          }
        }
      }
    },
    "/api/v1/collection": {
      "get": {
        "tags": [
          "Federation"
        ],
        "summary": "Entity collection (draft extension)",
        "parameters": [
          {
            "name": "trust_anchor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entity_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Collected entities"
          }
        }
      }
    },
    "/api/v1/test/resolve/{entityId}": {
      "get": {
        "tags": [
          "Federation"
        ],
        "summary": "Test resolution against every configured trust anchor",
        "parameters": [
          {
            "$ref": "#/components/parameters/entityId"
          }
        ],
        "responses": {
          "200": {
            "description": "Per-anchor results"
          }
        }
      }
    },
    "/api/v1/trust-anchors": {
      "get": {
        "tags": [
          "Trust anchors"
        ],
        "summary": "List configured trust anchors",
        "responses": {
          "200": {
            "description": "Configured anchors"
          }
        }
      }
    },
    "/api/v1/registered-trust-anchors": {
      "get": {
        "tags": [
          "Trust anchors"
        ],
        "summary": "List registered signing authorizations",
        "responses": {
          "200": {
            "description": "Registered anchors"
          }
        }
      }
    },
    "/api/v1/register-trust-anchor": {
      "post": {
        "tags": [
          "Trust anchors"
        ],
        "summary": "Register a trust anchor authorization",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "entity_id": {
                    "type": "string"
                  },
                  "entity_statement": {
                    "type": "string"
                  },
                  "registration_jwt": {
                    "type": "string"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registered"
          },
          "401": {
            "description": "Missing or invalid credentials"
          }
        },
        "security": [
          {
            "TABearer": []
          },
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/api/v1/registered-trust-anchors/{entityId}": {
      "delete": {
        "tags": [
          "Trust anchors"
        ],
        "summary": "Unregister a trust anchor authorization",
        "parameters": [
          {
            "$ref": "#/components/parameters/entityId"
          }
        ],
        "responses": {
          "200": {
            "description": "Unregistered"
          },
          "401": {
            "description": "Missing or invalid credentials"
          }
        },
        "security": [
          {
            "TABearer": []
          },
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/api/v1/cache/stats": {
      "get": {
        "tags": [
          "Cache"
        ],
        "summary": "Cache sizes",
        "responses": {
          "200": {
            "description": "Stats"
          }
        }
      }
    },
    "/api/v1/cache/entities": {
      "get": {
        "tags": [
          "Cache"
        ],
        "summary": "List cached entity statements",
        "responses": {
          "200": {
            "description": "Cached entities"
          }
        }
      }
    },
    "/api/v1/cache/chains": {
      "get": {
        "tags": [
          "Cache"
        ],
        "summary": "List cached trust chains",
        "responses": {
          "200": {
            "description": "Cached chains"
          }
        }
      }
    },
    "/api/v1/cache/entity/{entityId}": {
      "get": {
        "tags": [
          "Cache"
        ],
        "summary": "Inspect a cached entity",
        "parameters": [
          {
            "$ref": "#/components/parameters/entityId"
          },
          {
            "$ref": "#/components/parameters/trustAnchor"
          }
        ],
        "responses": {
          "200": {
            "description": "Cached entity"
          }
        }
      }
    },
    "/api/v1/cache/chain/{entityId}": {
      "get": {
        "tags": [
          "Cache"
        ],
        "summary": "Inspect a cached trust chain",
        "parameters": [
          {
            "$ref": "#/components/parameters/entityId"
          }
        ],
        "responses": {
          "200": {
            "description": "Cached chain"
          }
        }
      }
    },
    "/api/v1/auth/status": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Whether cache mutations / key rotate (API_KEY) and TA register/unregister (TA_API_KEY) are required",
        "responses": {
          "200": {
            "description": "Auth requirements"
          }
        }
      }
    },
    "/api/v1/auth/verify": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Verify operator API_KEY without mutating state",
        "description": "Returns 200 when Authorization: Bearer or X-API-Key matches API_KEY. Used by OIDF Admin to validate take-control.",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Key accepted"
          },
          "401": {
            "description": "Missing or wrong API_KEY"
          }
        }
      }
    },
    "/admin/v1": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "Node document (draft-kodden-oidfed-admin-00)",
        "description": "Identity, roles (resolver), and capabilities. Control-plane discovery for OIDF Admin. Requires API_KEY when set. This node does not implement subordinates or trust marks.",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Node document"
          },
          "401": {
            "description": "Missing or invalid API_KEY"
          }
        }
      }
    },
    "/admin/v1/configuration": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "Read Entity Configuration admin document",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Configuration document with ETag"
          }
        }
      },
      "put": {
        "tags": [
          "Administration"
        ],
        "summary": "Replace Entity Configuration admin document",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Updated document"
          }
        }
      },
      "patch": {
        "tags": [
          "Administration"
        ],
        "summary": "JSON Merge Patch Entity Configuration (RFC 7396)",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Updated document"
          }
        }
      }
    },
    "/admin/v1/configuration/statement": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "Published Entity Configuration JWT",
        "description": "Byte-for-byte the document at /.well-known/openid-federation.",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "application/entity-statement+jwt"
          }
        }
      }
    },
    "/admin/v1/keys": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List Federation Entity Keys",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Paged Key Documents"
          }
        }
      },
      "post": {
        "tags": [
          "Administration"
        ],
        "summary": "Generate a Federation Entity Key",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created Key Document"
          }
        }
      }
    },
    "/admin/v1/keys/{kid}": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "Read a Federation Entity Key",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "kid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Key Document"
          }
        }
      },
      "delete": {
        "tags": [
          "Administration"
        ],
        "summary": "Revoke a Federation Entity Key",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "kid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "409": {
            "description": "last_signing_key"
          }
        }
      }
    },
    "/admin/v1/keys/{kid}/rotate": {
      "post": {
        "tags": [
          "Administration"
        ],
        "summary": "Roll over a Federation Entity Key",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "kid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "New Key Document"
          }
        }
      }
    },
    "/admin/v1/tokens": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List personal access tokens",
        "description": "Secret-free PAT metadata. When API_KEY is set, only the ENV key may list or mint tokens (a PAT cannot manage other PATs).",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Token list"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "PAT presented; ENV API_KEY required to manage tokens"
          }
        }
      },
      "post": {
        "tags": [
          "Administration"
        ],
        "summary": "Create a personal access token",
        "description": "Returns the plaintext secret once. Prefix oidf_pat_. Body: { name, ttl_days }.",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created; token field is the secret"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "PAT presented; ENV API_KEY required to manage tokens"
          }
        }
      }
    },
    "/admin/v1/tokens/{id}": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "Read a personal access token",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token metadata"
          },
          "404": {
            "description": "Unknown token"
          }
        }
      },
      "delete": {
        "tags": [
          "Administration"
        ],
        "summary": "Revoke a personal access token",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked"
          },
          "404": {
            "description": "Unknown token"
          }
        }
      }
    },
    "/admin/v1/cache/clear-all": {
      "post": {
        "tags": [
          "Cache"
        ],
        "summary": "Clear entity and trust-chain caches",
        "responses": {
          "200": {
            "description": "Cleared"
          },
          "401": {
            "description": "Missing or invalid credentials"
          }
        },
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/admin/v1/cache/clear-entities": {
      "post": {
        "tags": [
          "Cache"
        ],
        "summary": "Clear entity cache",
        "responses": {
          "200": {
            "description": "Cleared"
          },
          "401": {
            "description": "Missing or invalid credentials"
          }
        },
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/admin/v1/cache/clear-chains": {
      "post": {
        "tags": [
          "Cache"
        ],
        "summary": "Clear trust-chain cache",
        "responses": {
          "200": {
            "description": "Cleared"
          },
          "401": {
            "description": "Missing or invalid credentials"
          }
        },
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/admin/v1/cache/entity/{entityId}": {
      "delete": {
        "tags": [
          "Cache"
        ],
        "summary": "Remove a cached entity",
        "parameters": [
          {
            "$ref": "#/components/parameters/entityId"
          },
          {
            "$ref": "#/components/parameters/trustAnchor"
          }
        ],
        "responses": {
          "200": {
            "description": "Removed"
          },
          "401": {
            "description": "Missing or invalid credentials"
          }
        },
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/admin/v1/cache/chain/{entityId}": {
      "delete": {
        "tags": [
          "Cache"
        ],
        "summary": "Remove a cached trust chain",
        "parameters": [
          {
            "$ref": "#/components/parameters/entityId"
          }
        ],
        "responses": {
          "200": {
            "description": "Removed"
          },
          "401": {
            "description": "Missing or invalid credentials"
          }
        },
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/admin/v1/audit": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List node administration audit events",
        "description": "Newest first. Mutating /admin/v1 requests only; GET this resource is not recorded.",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit page"
          },
          "401": {
            "description": "Missing or invalid credentials"
          }
        }
      }
    },
    "/admin/v1/whoami": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "Current admin identity",
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session or API key identity"
          },
          "401": {
            "description": "Missing or invalid credentials"
          }
        }
      }
    },
    "/admin/v1/cache/stats": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "Cache sizes (Administration API)",
        "responses": {
          "200": {
            "description": "Stats"
          }
        },
        "security": [
          {
            "OperatorBearer": []
          },
          {
            "ApiKey": []
          }
        ]
      }
    }
  }
}
